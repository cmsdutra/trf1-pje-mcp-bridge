{
  "name": "mcp-pje-trf1",
  "version": "1.0.0",
  "description": "Servidor MCP local para automação legítima do PJe TRF1 por usuários autenticados.",
  "main": "dist/server.js",
  "bin": {
    "mcp-pje-trf1": "dist/server.js",
    "mcp-pje-trf1-auth": "dist/cli/auth.js",
    "mcp-pje-trf1-inspect": "dist/cli/inspect.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "auth": "tsx src/cli/auth.ts",
    "inspect": "tsx src/cli/inspect.ts",
    "prepare": "npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "audit:full": "bash scripts/audit.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmsdutra/trf1-pje-mcp-bridge.git"
  },
  "keywords": [
    "mcp",
    "pje",
    "trf1",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/cmsdutra/trf1-pje-mcp-bridge/issues"
  },
  "homepage": "https://github.com/cmsdutra/trf1-pje-mcp-bridge#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9",
    "ip-address": "^10.7.6",
    "proxy-addr": "^2.0.8",
    "qs": "^6.17.1",
    "vite": "^8.3.6",
    "source-map-js": "^1.2.2",
    "brace-expansion": "^5.0.12",
    "nanoid": "^3.3.20"
  }
}
