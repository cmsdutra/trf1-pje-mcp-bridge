# Por padrão, o MCP usa uma pasta persistente do usuário:
# Windows: %APPDATA%\mcp-pje-trf1
# Linux/macOS: ~/.mcp-pje-trf1
#
# Defina estes valores apenas se quiser sobrescrever os padrões.
PJE_DOWNLOAD_DIR=
PJE_STORAGE_STATE_PATH=
PJE_HEADLESS=true
LOG_LEVEL=info
PJE_CHROMIUM_SANDBOX=true
PJE_MAX_SESSIONS=2
PJE_MAX_DOCUMENT_BYTES=104857600
PJE_MAX_BATCH_DOCUMENTS=1000
PJE_MAX_BATCH_BYTES=2147483648
PJE_DOWNLOAD_TIMEOUT_MS=600000
PJE_DOWNLOAD_CONCURRENCY=3
